DATABASE_URL=sqlite+aiosqlite:///./pylon_dummy.db
# Hosted Postgres (e.g. Neon): paste the provider's URL as-is; postgresql://...?sslmode=require is converted automatically.
# Use the direct (non-pooled) connection string.

# Slack (leave blank to keep the Slack adapter inert — Phase 8)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Gmail (leave blank to keep the Gmail adapter idle — Phase 9)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# AI layer (v2). Get a key from the Anthropic Console; never commit a real one.
ANTHROPIC_API_KEY=
# Only if your key is not scoped to one workspace (the API then returns "must include the anthropic-workspace-id header").
ANTHROPIC_WORKSPACE_ID=
# Optional: AI_MODEL=claude-opus-5-5 (default). AI_MAX_OUTPUT_TOKENS=8000

# Knowledge base / RAG (v2, Slice 2). Voyage AI makes the embeddings. Blank = retrieval is skipped and logged.
VOYAGE_API_KEY=
# Optional: EMBEDDING_MODEL=voyage-4 (1024 dimensions, the column size). KB_TOP_K=4

